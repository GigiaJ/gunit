(define-public ghidra-bin
  (package
    (name "ghidra-bin")
    (version "12.0.1")
    (source
     (origin
       (method url-fetch)
       (uri (string-append
             "https://github.com/NationalSecurityAgency/ghidra/releases/download/Ghidra_"
             version "_build/ghidra_" version "_PUBLIC_20260114.zip"))
       (sha256
        (base32 "0h8ggy67h049czkwcqmc7fz7gas03yxz228y9pgphfjzjj82kgc5"))))
    (build-system copy-build-system)
    (arguments
     (list
      #:phases
      #~(modify-phases %standard-phases
          (add-after 'install 'wrap-ghidra
            (lambda _
              (let* ((out #$output)
                     (orig (string-append out "/support/launch.sh.orig"))
                     (wrap (string-append out "/support/launch.sh")))
                (rename-file (string-append out "/support/launch.sh") orig)
                (call-with-output-file wrap
                  (lambda (port)
                    (format port "#!~a\n"
                            (which "bash"))
                    (format port "export _JAVA_AWT_WM_NONREPARENTING=1\n")
                    (format port "orig=\"~a\"\n" orig)
                    (format port "if [ $# -eq 0 ]; then\n")
                    (format port
                     "  exec \"$orig\" fg jdk Ghidra \"\" \"\" ghidra.GhidraRun")
                    (format port "\nelse\n")
                    (format port "  exec \"$orig\" \"$@\"\n")
                    (format port "fi\n")))
                (chmod wrap #o755)))))))
    (inputs (list gcc gcc-toolchain python gnu-make unzip))
    (native-inputs (list gcc-toolchain git unzip wget))
    (synopsis "A software reverse engineering suite")
    (home-page "https://ghidra-sre.org/")
    (description
     "A software reverse engineering (SRE) suite of tools developed by NSA's Research Directorate in support of the Cybersecurity mission")
    (license license:agpl3)))

