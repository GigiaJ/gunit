(define ghidra-ld.so.conf
  (packages->ld.so.conf (list (fhs-union `(,@ghidra-libs ,@fhs-min-libs)
                                         #:name "fhs-union-64"))))

(define ghidra-ld.so.cache
  (ld.so.conf->ld.so.cache ghidra-ld.so.conf))

(define-public ghidra-container
  (nonguix-container (name "ghidra")
                     (wrap-package ghidra-bin)
                     (run "/support/launch.sh")
                     (ld.so.conf ghidra-ld.so.conf)
                     (ld.so.cache ghidra-ld.so.cache)
                     (union64 (fhs-union `(,@ghidra-libs ,@fhs-min-libs)
                                         #:name "fhs-union-64"))
                     (link-files '("share/applications/ghidra.desktop"))
                     (description (package-description ghidra-bin))))

(define-public ghidra
  (nonguix-container->package ghidra-container))

